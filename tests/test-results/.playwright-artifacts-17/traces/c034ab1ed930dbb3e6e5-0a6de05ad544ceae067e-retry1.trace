ft-width: 2px;\n}\n.\\[\\&_blockquote\\]\\:border-primary\\/30 blockquote{\n  border-color: hsl(var(--primary) / 0.3);\n}\n.\\[\\&_blockquote\\]\\:border-primary\\/50 blockquote{\n  border-color: hsl(var(--primary) / 0.5);\n}\n.\\[\\&_blockquote\\]\\:pl-3 blockquote{\n  padding-left: 0.75rem;\n}\n.\\[\\&_blockquote\\]\\:italic blockquote{\n  font-style: italic;\n}\n.\\[\\&_blockquote\\]\\:text-muted-foreground blockquote{\n  color: hsl(var(--muted-foreground));\n}\n.\\[\\&_br\\]\\:my-0 br{\n  margin-top: 0px;\n  margin-bottom: 0px;\n}\n.\\[\\&_code\\]\\:rounded code{\n  border-radius: 0.25rem;\n}\n.\\[\\&_code\\]\\:bg-secondary\\/50 code{\n  background-color: hsl(var(--secondary) / 0.5);\n}\n.\\[\\&_code\\]\\:px-1 code{\n  padding-left: 0.25rem;\n  padding-right: 0.25rem;\n}\n.\\[\\&_code\\]\\:text-xs code{\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n.\\[\\&_code\\]\\:\\!text-\\[\\#00A1B2\\] code{\n  --tw-text-opacity: 1 !important;\n  color: rgb(0 161 178 / var(--tw-text-opacity, 1)) !important;\n}\n.dark\\:\\[\\&_code\\]\\:\\!text-\\[\\#00A1B2\\] code:is(.dark *){\n  --tw-text-opacity: 1 !important;\n  color: rgb(0 161 178 / var(--tw-text-opacity, 1)) !important;\n}\n.\\[\\&_hr\\]\\:my-2 hr{\n  margin-top: 0.5rem;\n  margin-bottom: 0.5rem;\n}\n.\\[\\&_hr\\]\\:border-border\\/40 hr{\n  border-color: hsl(var(--border) / 0.4);\n}\n.\\[\\&_img\\]\\:max-w-full img{\n  max-width: 100%;\n}\n.\\[\\&_img\\]\\:rounded img{\n  border-radius: 0.25rem;\n}\n.\\[\\&_ol\\]\\:my-0\\.5 ol{\n  margin-top: 0.125rem;\n  margin-bottom: 0.125rem;\n}\n.\\[\\&_ol\\]\\:list-decimal ol{\n  list-style-type: decimal;\n}\n.\\[\\&_ol\\]\\:pl-4 ol{\n  padding-left: 1rem;\n}\n.\\[\\&_p\\]\\:\\!m-0 p{\n  margin: 0px !important;\n}\n.\\[\\&_p\\]\\:my-0\\.5 p{\n  margin-top: 0.125rem;\n  margin-bottom: 0.125rem;\n}\n.\\[\\&_p\\]\\:leading-relaxed p{\n  line-height: 1.625;\n}\n.\\[\\&_p\\]\\:\\!text-gray-500 p{\n  --tw-text-opacity: 1 !important;\n  color: rgb(107 114 128 / var(--tw-text-opacity, 1)) !important;\n}\n.\\[\\&_p\\]\\:\\!text-gray-600 p{\n  --tw-text-opacity: 1 !important;\n  color: rgb(75 85 99 / var(--tw-text-opacity, 1)) !important;\n}\n.dark\\:\\[\\&_p\\]\\:\\!text-\\[\\#999999\\] p:is(.dark *){\n  --tw-text-opacity: 1 !important;\n  color: rgb(153 153 153 / var(--tw-text-opacity, 1)) !important;\n}\n.\\[\\&_pre\\]\\:overflow-x-auto pre{\n  overflow-x: auto;\n}\n.\\[\\&_pre\\]\\:rounded pre{\n  border-radius: 0.25rem;\n}\n.\\[\\&_pre\\]\\:bg-black\\/30 pre{\n  background-color: rgb(0 0 0 / 0.3);\n}\n.\\[\\&_pre\\]\\:bg-secondary\\/50 pre{\n  background-color: hsl(var(--secondary) / 0.5);\n}\n.\\[\\&_pre\\]\\:p-2 pre{\n  padding: 0.5rem;\n}\n.\\[\\&_pre\\]\\:font-mono pre{\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n}\n.\\[\\&_pre\\]\\:text-xs pre{\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n.\\[\\&_strong\\]\\:\\!text-gray-900 strong{\n  --tw-text-opacity: 1 !important;\n  color: rgb(17 24 39 / var(--tw-text-opacity, 1)) !important;\n}\n.dark\\:\\[\\&_strong\\]\\:\\!text-white strong:is(.dark *){\n  --tw-text-opacity: 1 !important;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1)) !important;\n}\n.\\[\\&_svg\\]\\:pointer-events-none svg{\n  pointer-events: none;\n}\n.\\[\\&_svg\\]\\:size-4 svg{\n  width: 1rem;\n  height: 1rem;\n}\n.\\[\\&_svg\\]\\:shrink-0 svg{\n  flex-shrink: 0;\n}\n.\\[\\&_tr\\:last-child\\]\\:border-0 tr:last-child{\n  border-width: 0px;\n}\n.\\[\\&_tr\\]\\:border-b tr{\n  border-bottom-width: 1px;\n}\n.\\[\\&_ul\\]\\:my-0\\.5 ul{\n  margin-top: 0.125rem;\n  margin-bottom: 0.125rem;\n}\n.\\[\\&_ul\\]\\:list-disc ul{\n  list-style-type: disc;\n}\n.\\[\\&_ul\\]\\:pl-4 ul{\n  padding-left: 1rem;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* Main app styles - minimal as most styling is in index.css and components */\n\n.App {\n  min-height: 100vh;\n  position: relative;\n}\n\n/* Gradient background overlay */\n.gradient-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  background: linear-gradient(135deg, rgba(17,24,39,0) 0%, rgba(13,101,118,0.12) 35%, rgba(65,148,196,0.12) 70%, rgba(17,24,39,0) 100%);\n}\n\n.light .gradient-overlay,\n:root.light .gradient-overlay {\n  background: none;\n}\n\n/* Ensure content is above gradient */\n.content-wrapper {\n  position: relative;\n  z-index: 1;\n}\n\n/* Drag overlay styles */\n.drag-overlay {\n  cursor: grabbing;\n}\n\n.drag-overlay * {\n  cursor: grabbing !important;\n}\n\n/* Animation for entrance */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in-up {\n  animation: fadeInUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;\n}\n\n/* Stagger animation for columns */\n.stagger-1 { animation-delay: 0ms; }\n.stagger-2 { animation-delay: 60ms; }\n.stagger-3 { animation-delay: 120ms; }\n.stagger-4 { animation-delay: 180ms; }\n.stagger-5 { animation-delay: 240ms; }\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* PublicDocs CSS - Background patterns and animations */\n\n/* Brockmann font for docs headings */\n@font-face {\n  font-family: 'Brockmann';\n  src: url(https://kb-wysiwyg-upgrade.preview.emergentagent.com/static/media/Brockmann-SemiBold.af1e03a714d350b73d19.otf) format('opentype');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* Docs page heading typography — scoped to .docs-prose */\n.docs-prose h1 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 30px !important;\n  line-height: 36px !important;\n  font-weight: 600 !important;\n  letter-spacing: -0.01em;\n}\n.docs-prose h2 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 24px !important;\n  line-height: 32px !important;\n  font-weight: 600 !important;\n  letter-spacing: -0.005em;\n}\n.docs-prose h3 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 20px !important;\n  line-height: 28px !important;\n  font-weight: 600 !important;\n}\n.docs-prose h4 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 18px !important;\n  line-height: 26px !important;\n  font-weight: 600 !important;\n}\n.docs-prose h5 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 16px !important;\n  line-height: 24px !important;\n  font-weight: 600 !important;\n}\n.docs-prose h6 {\n  font-family: 'Brockmann', sans-serif !important;\n  font-size: 14px !important;\n  line-height: 22px !important;\n  font-weight: 600 !important;\n}\n\n.bg-grid-pattern {\n  background-image:\n    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n\n.bg-hero-glow {\n  background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(24,132,85,0.08) 0%, transparent 70%);\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(8px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.animate-fadeIn {\n  animation: fadeIn 0.3s ease-out;\n}\n\n/* Smooth scrolling for TOC navigation */\nhtml {\n  scroll-behavior: smooth;\n}\n\n/* Sidebar scrollbar: hidden by default, visible on hover */\n.kb-sidebar-scroll {\n  scrollbar-width: none; /* Firefox */\n}\n.kb-sidebar-scroll::-webkit-scrollbar {\n  width: 0;\n}\n.kb-sidebar-scroll:hover {\n  scrollbar-width: thin; /* Firefox */\n  scrollbar-color: rgba(0,0,0,0.15) transparent;\n}\n.kb-sidebar-scroll:hover::-webkit-scrollbar {\n  width: 4px;\n}\n.kb-sidebar-scroll:hover::-webkit-scrollbar-thumb {\n  background: rgba(0,0,0,0.15);\n  border-radius: 4px;\n}\n:is(.dark) .kb-sidebar-scroll:hover {\n  scrollbar-color: rgba(255,255,255,0.1) transparent;\n}\n:is(.dark) .kb-sidebar-scroll:hover::-webkit-scrollbar-thumb {\n  background: rgba(255,255,255,0.1);\n}\n.kb-sidebar-scroll::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n/* Scrollbar - dark */\n.bg-\\[\\\\#0a0a0a\\] aside::-webkit-scrollbar { width: 4px; }\n.bg-\\[\\\\#0a0a0a\\] aside::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }\n.bg-\\[\\\\#0a0a0a\\] aside::-webkit-scrollbar-track { background: transparent; }\n\n/* Scrollbar - light */\naside::-webkit-scrollbar { width: 4px; }\naside::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 4px; }\naside::-webkit-scrollbar-track { background: transparent; }\n\n/* line clamp utility */\n.line-clamp-2 {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* Lead blockquote decorative quotes */\n.lead-quote > p::before {\n  content: \"\\201C\";\n}\n.lead-quote > p::after {\n  content: \"\\201D\";\n}\n\n/* Callout body: flatten code blocks and lists into flowing text */\n.callout-body > p { margin: 0; }\n.callout-body > p:not(:last-child) { margin-bottom: 0.5rem; }\n\n/* Dark mode callout body */\n:is(.dark) .callout-body > div { color: #999999; }\n\n/* Hide code block wrapper entirely, show content as plain text */\n.callout-body .code-block {\n  background: none !important;\n  border: none !important;\n  margin: 0.25rem 0 !important;\n  padding: 0 !important;\n  display: block;\n  border-radius: 0 !important;\n  overflow: visible !important;\n}\n.callout-body .code-block > div:first-child { display: none !important; }\n.callout-body .code-block pre,\n.callout-body .code-block pre[class*=\"language-\"] {\n  background: none !important;\n  border: none !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  white-space: pre-wrap !important;\n}\n:is(.dark) .callout-body .code-block pre,\n:is(.dark) .callout-body .code-block pre[class*=\"language-\"] {\n  color: #e2e8f0 !important;\n}\n.callout-body .code-block pre,\n.callout-body .code-block pre[class*=\"language-\"] {\n  color: #374151 !important;\n}\n:is(.dark) .callout-body .code-block pre,\n:is(.dark) .callout-body .code-block pre[class*=\"language-\"] {\n  color: #e2e8f0 !important;\n}\n\n/* Override inline styles from SyntaxHighlighter */\n.callout-body .code-block pre[style],\n.callout-body .code-block code[style] {\n  background: none !important;\n  font-family: inherit !important;\n  font-size: inherit !important;\n  line-height: inherit !important;\n}\n:is(.dark) .callout-body .code-block pre[style],\n:is(.dark) .callout-body .code-block code[style] {\n  color: #e2e8f0 !important;\n}\n.callout-body .code-block span[style] {\n  font-family: inherit !important;\n}\n:is(.dark) .callout-body .code-block span[style] {\n  color: #e2e8f0 !important;\n}\n.callout-body .code-block pre code {\n  background: none !important;\n  font-family: inherit !important;\n  font-size: inherit !important;\n}\n:is(.dark) .callout-body .code-block pre code {\n  color: #e2e8f0 !important;\n}\n/* Also target plain <pre><code> blocks (unlabeled code blocks) */\n.callout-body > pre,\n.callout-body pre {\n  background: none !important;\n  border: none !important;\n  padding: 0 !important;\n  margin: 0.25rem 0 !important;\n  font-family: inherit !important;\n  font-size: inherit !important;\n  line-height: inherit !important;\n  white-space: pre-wrap !important;\n  color: #374151 !important;\n}\n:is(.dark) .callout-body > pre,\n:is(.dark) .callout-body pre {\n  color: #e2e8f0 !important;\n}\n.callout-body pre > code,\n.callout-body code {\n  background: none !important;\n  font-family: inherit !important;\n  font-size: inherit !important;\n  padding: 0 !important;\n  color: #374151 !important;\n}\n:is(.dark) .callout-body pre > code,\n:is(.dark) .callout-body code {\n  color: #e2e8f0 !important;\n}\n.callout-body ul,\n.callout-body ol {\n  margin: 0.5rem 0 0 1.25rem;\n  padding: 0;\n}\n.callout-body li {\n  margin-bottom: 0.25rem;\n}\n\n\n/* Responsive: constrain media embeds (iframes, videos) on mobile */\n.prose iframe,\n.prose video,\n.prose embed,\n.prose object {\n  max-width: 100% !important;\n  height: auto;\n  aspect-ratio: 16/9;\n}\n\n/* Responsive: prevent tables from overflowing on mobile */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* Responsive: prevent long URLs/words from overflowing on mobile */\n.prose a {\n  word-break: break-word;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"]],"\n    ",["BODY",{},"\n        ","\n        ",["DIV",{"id":"root"},["DIV",{"class":"App min-h-screen bg-background","x-file-name":"App","x-line-number":"438","x-component":"div","x-id":"App_438","x-dynamic":"false"},["DIV",{"class":"min-h-screen flex items-center justify-center","x-file-name":"ProtectedRoute","x-line-number":"57","x-component":"div","x-id":"ProtectedRoute_57","x-dynamic":"false"},["DIV",{"class":"glass rounded-xl p-6","x-file-name":"ProtectedRoute","x-line-number":"58","x-component":"div","x-id":"ProtectedRoute_58","x-dynamic":"false"},["DIV",{"class":"animate-pulse text-foreground","x-file-name":"ProtectedRoute","x-line-number":"59","x-component":"div","x-id":"ProtectedRoute_59","x-dynamic":"false"},"Verifying session..."]]]]],"\n        ","\n        ","\n    ","\n\n\n"]],"viewport":{"width":1280,"height":720},"timestamp":298231.728,"wallTime":1772453695895,"collectionTime":6,"resourceOverrides":[],"isMainFrame":true}}
